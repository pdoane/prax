# What the scripts that run slangc share: shader_library.cmake, which compiles a source into a shader library, and
# render_shaders_check.cmake, which checks the material types and the shading models of a renderer's shader set. Both
# include this file from their own directory.

# Runs a command, and fails with its output if it fails.
function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    if (NOT result EQUAL 0)
        list(JOIN ARGN " " command)
        message(FATAL_ERROR "${command}\n${output}")
    endif()
endfunction()

# Appends to INPUTS the files that a Make-style dependency file lists.
function(read_depfile path)
    if (NOT EXISTS "${path}")
        return()
    endif()
    file(READ "${path}" text)
    string(REPLACE "\\\n" " " text "${text}")
    string(FIND "${text}" ": " colon)
    math(EXPR colon "${colon} + 2")
    string(SUBSTRING "${text}" ${colon} -1 text)
    # An escaped character stands for itself, and an escaped space is part of a name.
    string(REPLACE "\\\\" "<backslash>" text "${text}")
    string(REPLACE "\\ " "<space>" text "${text}")
    string(REGEX REPLACE "\\\\(.)" "\\1" text "${text}")
    string(REGEX REPLACE "[ \t\r\n]+" ";" text "${text}")
    set(found ${INPUTS})
    foreach (name IN LISTS text)
        if (name)
            string(REPLACE "<backslash>" "\\" name "${name}")
            string(REPLACE "<space>" " " name "${name}")
            list(APPEND found "${name}")
        endif()
    endforeach()
    set(INPUTS ${found} PARENT_SCOPE)
endfunction()

# Writes a Make-style dependency file at `path`, which says that `output` depends on each file of INPUTS.
function(write_depfile path output)
    set(inputs ${INPUTS})
    list(REMOVE_DUPLICATES inputs)
    list(SORT inputs)
    string(REPLACE " " "\\ " escaped_output "${output}")
    set(text "${escaped_output}: \\\n")
    foreach (name IN LISTS inputs)
        string(REPLACE "\\" "/" name "${name}")
        string(REPLACE " " "\\ " name "${name}")
        string(APPEND text "    ${name} \\\n")
    endforeach()
    string(APPEND text "\n")
    file(CONFIGURE OUTPUT "${path}" CONTENT "${text}" @ONLY)
endfunction()

# Sets SIZE and ALIGNMENT to the size and the alignment of a reflected type as C lays it out under pr/gpu.slang's rules:
# a scalar at its size, a 2-vector at twice its scalar's, a 4-vector at four times, and a structure at its largest
# field's.
function(c_layout type)
    string(JSON kind GET "${type}" kind)
    set(size 0)
    set(alignment 1)
    if (kind STREQUAL "scalar")
        string(JSON scalar GET "${type}" scalarType)
        set(size 4)
        if (scalar MATCHES "^(float16|int16|uint16)$")
            set(size 2)
        elseif (scalar MATCHES "^(float64|int64|uint64)$")
            set(size 8)
        endif()
        set(alignment ${size})
    elseif (kind STREQUAL "vector")
        string(JSON element GET "${type}" elementType)
        string(JSON count GET "${type}" elementCount)
        c_layout("${element}")
        set(scalar ${SIZE})
        math(EXPR size "${scalar} * ${count}")
        if (count EQUAL 3)
            math(EXPR alignment "${scalar} * 4")
        else()
            math(EXPR alignment "${scalar} * ${count}")
        endif()
    elseif (kind STREQUAL "matrix")
        string(JSON element GET "${type}" elementType)
        string(JSON columns GET "${type}" columnCount)
        string(JSON rows GET "${type}" rowCount)
        c_layout("{\"kind\": \"vector\", \"elementCount\": ${columns}, \"elementType\": ${element}}")
        set(alignment ${ALIGNMENT})
        math(EXPR size "${alignment} * ${rows}")
    elseif (kind STREQUAL "array")
        string(JSON element GET "${type}" elementType)
        string(JSON count GET "${type}" elementCount)
        c_layout("${element}")
        math(EXPR size "${SIZE} * ${count}")
        set(alignment ${ALIGNMENT})
    elseif (kind STREQUAL "struct")
        set(offset 0)
        set(largest 1)
        string(JSON count LENGTH "${type}" fields)
        if (count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach (index RANGE ${last})
                string(JSON field GET "${type}" fields ${index} type)
                c_layout("${field}")
                math(EXPR offset "(${offset} + ${ALIGNMENT} - 1) / ${ALIGNMENT} * ${ALIGNMENT} + ${SIZE}")
                if (ALIGNMENT GREATER largest)
                    set(largest ${ALIGNMENT})
                endif()
            endforeach()
        endif()
        math(EXPR size "(${offset} + ${largest} - 1) / ${largest} * ${largest}")
        set(alignment ${largest})
    endif()
    set(SIZE ${size} PARENT_SCOPE)
    set(ALIGNMENT ${alignment} PARENT_SCOPE)
endfunction()

# Appends to PROBLEMS what keeps a reflected type from laying out in a buffer as it does in C (pr/gpu.slang): a
# 3-vector, a matrix or a boolean, and a field that C moves to a multiple of its alignment, which a shader's load does
# not. `path` names the type in the messages. Sets PACKED to the size of the type as a shader loads it, with every
# field after the one before.
function(buffer_layout_problems type path)
    set(problems ${PROBLEMS})
    string(JSON kind GET "${type}" kind)
    set(packed 0)
    if (kind STREQUAL "scalar")
        string(JSON scalar GET "${type}" scalarType)
        if (NOT scalar MATCHES "^(float32|int32|uint32)$")
            list(APPEND problems "${path} is a ${scalar}. A record holds floats and 32-bit integers")
        endif()
        set(packed 4)
    elseif (kind STREQUAL "vector")
        string(JSON count GET "${type}" elementCount)
        if (count EQUAL 3)
            list(APPEND problems
                 "${path} is a 3-vector, which C and the shaders lay out differently. Make it a 4-vector")
        endif()
        math(EXPR packed "4 * ${count}")
    elseif (kind STREQUAL "matrix")
        list(APPEND problems "${path} is a matrix. Give its rows as 4-vectors")
        c_layout("${type}")
        set(packed ${SIZE})
    elseif (kind STREQUAL "array")
        string(JSON element GET "${type}" elementType)
        string(JSON count GET "${type}" elementCount)
        set(PROBLEMS ${problems})
        buffer_layout_problems("${element}" "${path}[]")
        set(problems ${PROBLEMS})
        math(EXPR packed "${PACKED} * ${count}")
    elseif (kind STREQUAL "struct")
        string(JSON count LENGTH "${type}" fields)
        if (count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach (index RANGE ${last})
                string(JSON field GET "${type}" fields ${index} type)
                string(JSON name GET "${type}" fields ${index} name)
                c_layout("${field}")
                math(EXPR remainder "${packed} % ${ALIGNMENT}")
                if (NOT remainder EQUAL 0)
                    list(APPEND problems "${path}.${name} follows ${packed} bytes, and C moves it to a multiple of \
${ALIGNMENT}. Order the fields, or add padding, so that it starts at one")
                endif()
                set(PROBLEMS ${problems})
                buffer_layout_problems("${field}" "${path}.${name}")
                set(problems ${PROBLEMS})
                math(EXPR packed "${packed} + ${PACKED}")
            endforeach()
        endif()
    else()
        list(APPEND problems "${path} is a ${kind}, which a record cannot hold")
    endif()
    set(PROBLEMS ${problems} PARENT_SCOPE)
    set(PACKED ${packed} PARENT_SCOPE)
endfunction()
