# Compiles a Slang source into a shader library for lib/gpu, and writes it as a C header that holds the library's bytes
# as `const unsigned char <variable>[]`. pr_slang (build.cmake) runs it in CMake's script mode.
#
# A library holds every entry point of the source, each named by its function, with its stage and, for a compute shader,
# its group size, which the reflection of the compiled code gives. It holds code for each target named, for the backend
# that runs it: a metallib for Metal, a SPIR-V module for Vulkan, and DXIL for Direct3D 12. The source is compiled once
# per target with PR_GPU_METAL, PR_GPU_VULKAN or PR_GPU_D3D12 defined to 1.
#
# Vulkan has two targets. `spirv` is the baseline, which reads a copy of a pipeline's target. `spirv_local_read` is for
# devices with dynamic rendering local read, and reads the target as an input attachment. It is compiled with
# PR_GPU_LOCAL_READ also defined. A module that reads no target serves both, so the library holds it once.
#
# The layout is the one that lib/gpu's prGpuShaderLibraryCreate reads. Every number is a little-endian 32-bit word.
#
#     header      the magic "PRSL", the version, the number of entry points, the number of targets
#     entries     for each entry point: the offset and size of its name, its stage, and its group size (x, y, z)
#     targets     for each target: its PrGpuShaderTarget, then for each entry point the offset and size of its code
#     names, then the code, each blob aligned to 16 bytes
#
# A target whose code holds every entry point, as a metallib and a SPIR-V module do, gives every entry point the same
# blob.
#
#   cmake -DSLANGC=<path> -DTARGETS=<target>[|<target>...] -DVARIABLE=<name> [-DINCLUDES=<directory>[|...]]
#         -DSOURCE=<path> -DHEADER=<path> -DSCRATCH=<directory> -DROOT=<directory> [-DDEPFILE=<path>]
#         -P shader_library.cmake
#
# ROOT is the directory that the header names the source relative to.

cmake_minimum_required(VERSION 3.28)

set(MAGIC 0x4C535250)
set(VERSION 2)

# pr/gpu_backend.h's PrGpuShaderTarget, and the macro that each target defines for the source.
set(TARGET_metal 1)
set(TARGET_spirv 2)
set(TARGET_spirv_local_read 3)
set(TARGET_dxil 4)
set(DEFINE_metal PR_GPU_METAL)
set(DEFINE_spirv PR_GPU_VULKAN)
set(DEFINE_spirv_local_read PR_GPU_VULKAN PR_GPU_LOCAL_READ)
set(DEFINE_dxil PR_GPU_D3D12)

# pr/gpu_backend.h's PrGpuShaderStage, by the name that Slang's reflection gives the stage, which slangc's -stage option
# also takes.
set(STAGE_vertex 0)
set(STAGE_fragment 1)
set(STAGE_compute 2)

string(REPLACE "|" ";" TARGETS "${TARGETS}")
string(REPLACE "|" ";" INCLUDES "${INCLUDES}")
if (NOT EXISTS "${SLANGC}")
    message(FATAL_ERROR "shader_library: no slangc at ${SLANGC}")
endif()

# Runs a command, and fails with its output if it fails.
function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    if (NOT result EQUAL 0)
        list(JOIN ARGN " " command)
        message(FATAL_ERROR "${command}\n${output}")
    endif()
endfunction()

# Appends to INPUTS the files that a Make-style dependency file lists.
function(read_depfile path)
    if (NOT EXISTS "${path}")
        return()
    endif()
    file(READ "${path}" text)
    string(REPLACE "\\\n" " " text "${text}")
    string(FIND "${text}" ": " colon)
    math(EXPR colon "${colon} + 2")
    string(SUBSTRING "${text}" ${colon} -1 text)
    # An escaped character stands for itself, and an escaped space is part of a name.
    string(REPLACE "\\\\" "<backslash>" text "${text}")
    string(REPLACE "\\ " "<space>" text "${text}")
    string(REGEX REPLACE "\\\\(.)" "\\1" text "${text}")
    string(REGEX REPLACE "[ \t\r\n]+" ";" text "${text}")
    set(found ${INPUTS})
    foreach (name IN LISTS text)
        if (name)
            string(REPLACE "<backslash>" "\\" name "${name}")
            string(REPLACE "<space>" " " name "${name}")
            list(APPEND found "${name}")
        endif()
    endforeach()
    set(INPUTS ${found} PARENT_SCOPE)
endfunction()

# Runs slangc on the source for `target`, writing `output`, its reflection and its dependencies. An empty `output`
# writes no code, for a target that compiles each entry point on its own. Sets REFLECTED to the reflection, and appends
# the files that the source read to INPUTS.
function(slang target directory output name)
    set(reflection "${directory}/${name}.json")
    set(depfile "${directory}/${name}.d")
    set(command "${SLANGC}" "${SOURCE}")
    foreach (define IN LISTS DEFINE_${target})
        list(APPEND command -D ${define}=1)
    endforeach()
    list(APPEND command -warnings-as-errors all -O2 -matrix-layout-row-major -reflection-json "${reflection}"
        -depfile "${depfile}" ${ARGN})
    if (output)
        list(APPEND command -o "${output}")
    endif()
    foreach (include IN LISTS INCLUDES)
        list(APPEND command -I "${include}")
    endforeach()
    run(${command})
    file(READ "${reflection}" reflected)
    set(REFLECTED "${reflected}" PARENT_SCOPE)
    read_depfile("${depfile}")
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Sets RECORDS to (name, stage, group size) for each entry point of a reflection, each "<name>|<stage>|<x>|<y>|<z>".
function(entry_records reflected)
    set(records "")
    string(JSON count ERROR_VARIABLE missing LENGTH "${reflected}" entryPoints)
    if (missing)
        set(count 0)
    endif()
    if (count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach (index RANGE ${last})
            string(JSON name GET "${reflected}" entryPoints ${index} name)
            string(JSON stage GET "${reflected}" entryPoints ${index} stage)
            if (NOT DEFINED STAGE_${stage})
                message(FATAL_ERROR "${name}: entry point ${name} has stage ${stage}, which lib/gpu does not run")
            endif()
            set(group 0|0|0)
            string(JSON size ERROR_VARIABLE none GET "${reflected}" entryPoints ${index} threadGroupSize)
            if (NOT none)
                string(JSON x GET "${size}" 0)
                string(JSON y GET "${size}" 1)
                string(JSON z GET "${size}" 2)
                set(group ${x}|${y}|${z})
            endif()
            list(APPEND records "${name}|${STAGE_${stage}}|${group}")
        endforeach()
    endif()
    set(RECORDS ${records} PARENT_SCOPE)
endfunction()

# Compiles the Metal target: one metallib that holds every entry point.
function(compile_metal directory)
    set(source "${directory}/library.metal")
    slang(metal "${directory}" "${source}" metal -target metal)
    # Slang declares every buffer writable. The heaps are only read, and a vertex function that writes nothing may not
    # take writable buffers without a warning.
    file(READ "${source}" text)
    string(REGEX REPLACE "uint32_t device\\* (prGpu(Resource|Sampler)Heap_[0-9]+)" "uint32_t const device* \\1"
           text "${text}")
    file(WRITE "${source}" "${text}")
    run(xcrun -sdk macosx metal -std=metal4.0 -mmacosx-version-min=26.0 -c "${source}" -o "${directory}/library.air")
    run(xcrun -sdk macosx metallib "${directory}/library.air" -o "${directory}/library.metallib")
    entry_records("${REFLECTED}")
    set(RECORDS ${RECORDS} PARENT_SCOPE)
    set(CODES "${directory}/library.metallib" PARENT_SCOPE)
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Compiles a Vulkan target: one SPIR-V module that holds every entry point. It is Vulkan 1.3's SPIR-V, with fine
# derivatives, which every device that lib/gpu runs on has. Handles index the bindless set at set 2 (pr/gpu.slang),
# whatever sets the source declares.
function(compile_spirv target directory)
    slang(${target} "${directory}" "${directory}/library.spv" spirv -target spirv
          -profile spirv_1_6+spvDerivativeControl -fvk-use-entrypoint-name -bindless-space-index 2)
    entry_records("${REFLECTED}")
    set(RECORDS ${RECORDS} PARENT_SCOPE)
    set(CODES "${directory}/library.spv" PARENT_SCOPE)
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Sets SIZE and ALIGNMENT to the size and the alignment of a reflected type as C lays it out under pr/gpu.slang's rules:
# a scalar at its size, a 2-vector at twice its scalar's, a 4-vector at four times, and a structure at its largest
# field's.
function(c_layout type)
    string(JSON kind GET "${type}" kind)
    set(size 0)
    set(alignment 1)
    if (kind STREQUAL "scalar")
        string(JSON scalar GET "${type}" scalarType)
        set(size 4)
        if (scalar MATCHES "^(float16|int16|uint16)$")
            set(size 2)
        elseif (scalar MATCHES "^(float64|int64|uint64)$")
            set(size 8)
        endif()
        set(alignment ${size})
    elseif (kind STREQUAL "vector")
        string(JSON element GET "${type}" elementType)
        string(JSON count GET "${type}" elementCount)
        c_layout("${element}")
        set(scalar ${SIZE})
        math(EXPR size "${scalar} * ${count}")
        if (count EQUAL 3)
            math(EXPR alignment "${scalar} * 4")
        else()
            math(EXPR alignment "${scalar} * ${count}")
        endif()
    elseif (kind STREQUAL "matrix")
        string(JSON element GET "${type}" elementType)
        string(JSON columns GET "${type}" columnCount)
        string(JSON rows GET "${type}" rowCount)
        c_layout("{\"kind\": \"vector\", \"elementCount\": ${columns}, \"elementType\": ${element}}")
        set(alignment ${ALIGNMENT})
        math(EXPR size "${alignment} * ${rows}")
    elseif (kind STREQUAL "array")
        string(JSON element GET "${type}" elementType)
        string(JSON count GET "${type}" elementCount)
        c_layout("${element}")
        math(EXPR size "${SIZE} * ${count}")
        set(alignment ${ALIGNMENT})
    elseif (kind STREQUAL "struct")
        set(offset 0)
        set(largest 1)
        string(JSON count LENGTH "${type}" fields)
        if (count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach (index RANGE ${last})
                string(JSON field GET "${type}" fields ${index} type)
                c_layout("${field}")
                math(EXPR offset "(${offset} + ${ALIGNMENT} - 1) / ${ALIGNMENT} * ${ALIGNMENT} + ${SIZE}")
                if (ALIGNMENT GREATER largest)
                    set(largest ${ALIGNMENT})
                endif()
            endforeach()
        endif()
        math(EXPR size "(${offset} + ${largest} - 1) / ${largest} * ${largest}")
        set(alignment ${largest})
    endif()
    set(SIZE ${size} PARENT_SCOPE)
    set(ALIGNMENT ${alignment} PARENT_SCOPE)
endfunction()

# Appends to PROBLEMS each field of a reflected structure, and each array, whose offset or stride in a constant buffer
# differs from C's.
function(root_layout_problems type path)
    set(problems ${PROBLEMS})
    string(JSON kind GET "${type}" kind)
    if (kind STREQUAL "array")
        string(JSON element GET "${type}" elementType)
        c_layout("${element}")
        set(stride ${SIZE})
        string(JSON reflected ERROR_VARIABLE none GET "${type}" uniformStride)
        if (NOT none)
            set(stride ${reflected})
        endif()
        if (NOT stride EQUAL SIZE)
            list(APPEND problems "${path} is an array whose elements lie ${stride} bytes apart in a constant buffer, \
and ${SIZE} in C. Make it an array of 4-vectors, or of structures whose size is a multiple of 16 bytes")
        endif()
        set(PROBLEMS ${problems})
        root_layout_problems("${element}" "${path}[]")
        set(PROBLEMS ${PROBLEMS} PARENT_SCOPE)
        return()
    endif()
    if (NOT kind STREQUAL "struct")
        return()
    endif()
    set(at 0)
    string(JSON count LENGTH "${type}" fields)
    if (count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach (index RANGE ${last})
            string(JSON field GET "${type}" fields ${index})
            string(JSON field_type GET "${field}" type)
            string(JSON name GET "${field}" name)
            c_layout("${field_type}")
            set(size ${SIZE})
            math(EXPR at "(${at} + ${ALIGNMENT} - 1) / ${ALIGNMENT} * ${ALIGNMENT}")
            set(reflected ${at})
            string(JSON offset ERROR_VARIABLE none GET "${field}" binding offset)
            if (NOT none)
                set(reflected ${offset})
            endif()
            if (NOT reflected EQUAL at)
                list(APPEND problems
                     "${path}.${name} lies at byte ${reflected} in a constant buffer, and at byte ${at} in C")
                set(PROBLEMS ${problems} PARENT_SCOPE)
                return()
            endif()
            set(PROBLEMS ${problems})
            root_layout_problems("${field_type}" "${path}.${name}")
            set(problems ${PROBLEMS})
            math(EXPR at "${at} + ${size}")
        endforeach()
    endif()
    set(PROBLEMS ${problems} PARENT_SCOPE)
endfunction()

# Fails if the root data that the source declares lays out differently in Direct3D 12's constant buffers than in C,
# which pr/gpu.slang requires them to agree on.
function(check_root_layout reflected)
    set(PROBLEMS "")
    string(JSON count ERROR_VARIABLE missing LENGTH "${reflected}" parameters)
    if (missing OR count EQUAL 0)
        return()
    endif()
    math(EXPR last "${count} - 1")
    foreach (index RANGE ${last})
        string(JSON parameter GET "${reflected}" parameters ${index})
        string(JSON binding_kind ERROR_VARIABLE none GET "${parameter}" binding kind)
        string(JSON type_kind ERROR_VARIABLE none2 GET "${parameter}" type kind)
        if (NOT none AND NOT none2 AND binding_kind STREQUAL "constantBuffer" AND type_kind STREQUAL "constantBuffer")
            string(JSON element GET "${parameter}" type elementType)
            string(JSON name GET "${parameter}" name)
            root_layout_problems("${element}" "${name}")
        endif()
    endforeach()
    if (PROBLEMS)
        list(TRANSFORM PROBLEMS PREPEND "${SOURCE}: ")
        list(JOIN PROBLEMS "\n" text)
        message(FATAL_ERROR "${text}")
    endif()
endfunction()

# Compiles the Direct3D 12 target: the DXIL of each entry point, compiled on its own. The whole module is reflected as
# HLSL without generating its code, which slangc writes only for entry points named with their outputs.
function(compile_dxil directory)
    slang(dxil "${directory}" "" dxil -target hlsl -no-codegen)
    check_root_layout("${REFLECTED}")
    entry_records("${REFLECTED}")
    set(codes "")
    foreach (record IN LISTS RECORDS)
        string(REPLACE "|" ";" fields "${record}")
        list(GET fields 0 name)
        list(GET fields 1 stage)
        foreach (stage_name vertex fragment compute)
            if (STAGE_${stage_name} EQUAL stage)
                set(option ${stage_name})
            endif()
        endforeach()
        slang(dxil "${directory}" "${directory}/${name}.dxil" "${name}" -target dxil -profile sm_6_6 -entry "${name}"
              -stage ${option})
        list(APPEND codes "${directory}/${name}.dxil")
    endforeach()
    set(RECORDS ${RECORDS} PARENT_SCOPE)
    set(CODES ${codes} PARENT_SCOPE)
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Sets `out` to the hex of a little-endian 32-bit word.
function(word out value)
    math(EXPR hex "${value}" OUTPUT_FORMAT HEXADECIMAL)
    string(TOLOWER "${hex}" hex)
    string(SUBSTRING "${hex}" 2 -1 hex)
    string(LENGTH "${hex}" length)
    math(EXPR padding "8 - ${length}")
    string(REPEAT "0" ${padding} zeros)
    set(hex "${zeros}${hex}")
    string(SUBSTRING "${hex}" 6 2 b0)
    string(SUBSTRING "${hex}" 4 2 b1)
    string(SUBSTRING "${hex}" 2 2 b2)
    string(SUBSTRING "${hex}" 0 2 b3)
    set(${out} "${b0}${b1}${b2}${b3}" PARENT_SCOPE)
endfunction()

# Appends zero bytes to the hex in `variable` until its length is a multiple of 16 bytes.
function(align variable)
    string(LENGTH "${${variable}}" length)
    math(EXPR padding "(16 - ${length} / 2 % 16) % 16")
    string(REPEAT "00" ${padding} zeros)
    set(${variable} "${${variable}}${zeros}" PARENT_SCOPE)
endfunction()

# A source compiled for Vulkan is compiled for both of its targets. The local-read module comes first, because it shows
# whether the source reads the target.
if ("spirv" IN_LIST TARGETS)
    list(REMOVE_ITEM TARGETS spirv)
    list(APPEND TARGETS spirv_local_read spirv)
endif()

set(INPUTS "${SOURCE}")
set(ENTRIES "")
set(ENTRIES_SET FALSE)
foreach (target IN LISTS TARGETS)
    set(scratch "${SCRATCH}/${target}")
    file(REMOVE_RECURSE "${scratch}")
    file(MAKE_DIRECTORY "${scratch}")
    if (target STREQUAL "metal")
        compile_metal("${scratch}")
    elseif (target STREQUAL "spirv_local_read")
        compile_spirv(spirv_local_read "${scratch}")
        # A module that reads the target declares OpCapability InputAttachment, whose little-endian words follow the
        # module's header.
        file(READ "${scratch}/library.spv" module HEX)
        string(FIND "${module}" "1100020028000000" READS_TARGET)
    elseif (target STREQUAL "spirv" AND READS_TARGET EQUAL -1)
        set(CODES ${CODES_spirv_local_read})
    elseif (target STREQUAL "spirv")
        compile_spirv(spirv "${scratch}")
    elseif (target STREQUAL "dxil")
        compile_dxil("${scratch}")
    else()
        message(FATAL_ERROR "shader_library: no target named ${target}")
    endif()
    if (NOT ENTRIES_SET)
        set(ENTRIES ${RECORDS})
        set(ENTRIES_SET TRUE)
    elseif (NOT "${RECORDS}" STREQUAL "${ENTRIES}")
        message(FATAL_ERROR "${SOURCE}: the entry points differ between targets")
    endif()
    set(CODES_${target} ${CODES})
endforeach()
list(LENGTH ENTRIES entry_count)
if (entry_count EQUAL 0)
    message(FATAL_ERROR "${SOURCE}: no entry points")
endif()
list(LENGTH TARGETS target_count)

# The library's bytes, as hex: the tables, the names, then the blobs, each placed once however many entry points share
# it.
math(EXPR tables_size "16 + 24 * ${entry_count} + (4 + 8 * ${entry_count}) * ${target_count}")
set(names "")
set(entry_hex "")
foreach (record IN LISTS ENTRIES)
    string(REPLACE "|" ";" fields "${record}")
    list(GET fields 0 name)
    string(HEX "${name}" name_hex)
    string(LENGTH "${names}" names_length)
    string(LENGTH "${name_hex}" name_length)
    math(EXPR offset "${tables_size} + ${names_length} / 2")
    math(EXPR name_length "${name_length} / 2")
    foreach (value ${offset} ${name_length})
        word(hex ${value})
        string(APPEND entry_hex "${hex}")
    endforeach()
    list(SUBLIST fields 1 4 numbers)
    foreach (value IN LISTS numbers)
        word(hex ${value})
        string(APPEND entry_hex "${hex}")
    endforeach()
    string(APPEND names "${name_hex}")
endforeach()
set(blobs "${names}")
align(blobs)
set(target_hex "")
foreach (target IN LISTS TARGETS)
    word(hex ${TARGET_${target}})
    string(APPEND target_hex "${hex}")
    list(LENGTH CODES_${target} code_count)
    foreach (index RANGE 1 ${entry_count})
        # A target with one code gives it to every entry point.
        if (code_count EQUAL 1)
            list(GET CODES_${target} 0 code)
        else()
            math(EXPR at "${index} - 1")
            list(GET CODES_${target} ${at} code)
        endif()
        string(MAKE_C_IDENTIFIER "${code}" key)
        if (NOT DEFINED PLACED_${key})
            string(LENGTH "${blobs}" blobs_length)
            math(EXPR PLACED_${key} "${tables_size} + ${blobs_length} / 2")
            file(READ "${code}" code_hex HEX)
            string(LENGTH "${code_hex}" code_length)
            math(EXPR SIZE_${key} "${code_length} / 2")
            string(APPEND blobs "${code_hex}")
            align(blobs)
        endif()
        word(hex ${PLACED_${key}})
        string(APPEND target_hex "${hex}")
        word(hex ${SIZE_${key}})
        string(APPEND target_hex "${hex}")
    endforeach()
endforeach()
set(library "")
foreach (value ${MAGIC} ${VERSION} ${entry_count} ${target_count})
    word(hex ${value})
    string(APPEND library "${hex}")
endforeach()
string(APPEND library "${entry_hex}${target_hex}${blobs}")

# The header: 24 bytes to a line.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${library}")
string(REPEAT "." 120 line)
string(REGEX REPLACE "(${line})" "    \\1\n" bytes "${bytes}")
string(FIND "${bytes}" "\n" end REVERSE)
math(EXPR end "${end} + 1")
string(SUBSTRING "${bytes}" ${end} -1 rest)
if (rest)
    string(SUBSTRING "${bytes}" 0 ${end} bytes)
    string(APPEND bytes "    ${rest}\n")
endif()
cmake_path(RELATIVE_PATH SOURCE BASE_DIRECTORY "${ROOT}" OUTPUT_VARIABLE relative)
file(CONFIGURE OUTPUT "${HEADER}" @ONLY CONTENT "// Generated by cmake/shader_library.cmake from @relative@. Do not edit.

#pragma once

alignas(16) const unsigned char @VARIABLE@[] = {
@bytes@};
")

# The dependency file: the header, and every file that a compile read.
if (DEPFILE)
    list(REMOVE_DUPLICATES INPUTS)
    list(SORT INPUTS)
    string(REPLACE " " "\\ " escaped_header "${HEADER}")
    set(text "${escaped_header}: \\\n")
    foreach (name IN LISTS INPUTS)
        string(REPLACE "\\" "/" name "${name}")
        string(REPLACE " " "\\ " name "${name}")
        string(APPEND text "    ${name} \\\n")
    endforeach()
    string(APPEND text "\n")
    file(CONFIGURE OUTPUT "${DEPFILE}" CONTENT "${text}" @ONLY)
endif()
