# Compiles a Slang source into a shader library for lib/gpu, and writes it as a C header that holds the library's bytes
# as `const unsigned char <variable>[]`. pr_slang (build.cmake) runs it in CMake's script mode.
#
# A library holds every entry point of the source, each named by its function, with its stage and, for a compute shader,
# its group size, and every slot that the source declares (pr/gpu.slang's PR_GPU_BUFFER and the others), named by its
# variable, with its kind and its number, which the reflection of the compiled code gives. It holds code for each
# target named, for the backend that runs it: a metallib for Metal, a SPIR-V module for Vulkan, DXIL for Direct3D 12,
# DXBC for Direct3D 11, and WGSL for WebGPU. The source is compiled once per target with PR_GPU_METAL, PR_GPU_VULKAN,
# PR_GPU_D3D12, PR_GPU_D3D11 or PR_GPU_WEBGPU defined to 1.
#
# Vulkan has two targets. `spirv` is the baseline, which does not read a pipeline's target. `spirv_local_read` is for
# devices with dynamic rendering local read, and reads the target as an input attachment. It is compiled with
# PR_GPU_LOCAL_READ also defined. A build names either target or both. If it names both, a module that does not read
# the target serves both, and the library holds it once.
#
# The layout is the one that lib/gpu's prGpuShaderLibraryCreate reads. Every number is a little-endian 32-bit word.
#
#     header      the magic "PRSL", the version, the numbers of entry points, of targets and of slots
#     entries     for each entry point: the offset and size of its name, its stage, and its group size (x, y, z)
#     slots       for each slot: the offset and size of its name, its PrGpuSlotKind, and its number
#     targets     for each target: its PrGpuShaderTarget, then for each entry point the offset and size of its code
#     names, then the code, each blob aligned to 16 bytes
#
# A target whose code holds every entry point, as a metallib and a SPIR-V module do, gives every entry point the same
# blob.
#
#   cmake -DSLANGC=<path> -DTARGETS=<target>[|<target>...] -DVARIABLE=<name> [-DINCLUDES=<directory>[|...]]
#         [-DDEFINES=<macro>[|...]] [-DMETAL_SDK=<sdk>] [-DPRECISE=ON] -DSOURCE=<path> -DHEADER=<path>
#         -DSCRATCH=<directory> -DROOT=<directory> [-DDEPFILE=<path>] -P shader_library.cmake
#
# DEFINES names macros that every target compiles the source with, each defined to 1, beside the target's own.
#
# PRECISE compiles the floating-point arithmetic as it is written: Slang's precise mode, and Metal's compiler without
# fast math. By default a compiler may fuse a multiply into an add, and reassociate, where its code allows, so two
# libraries that compile the same arithmetic beside different code, as the binding tiers' do, may round it apart.
#
# ROOT is the directory that the header names the source relative to. METAL_SDK is the SDK that the metallib runs on:
# macosx, the default, or the devices' or the simulator's SDK of a UIKit platform, as iphoneos or xrsimulator.

cmake_minimum_required(VERSION 3.28)

set(MAGIC 0x4C535250)
set(VERSION 3)

# pr/gpu_backend.h's PrGpuShaderTarget, and the macro that each target defines for the source.
set(TARGET_metal 1)
set(TARGET_spirv 2)
set(TARGET_spirv_local_read 3)
set(TARGET_dxil 4)
set(TARGET_wgsl 5)
set(TARGET_dxbc 6)
set(DEFINE_metal PR_GPU_METAL)
set(DEFINE_spirv PR_GPU_VULKAN)
set(DEFINE_spirv_local_read PR_GPU_VULKAN PR_GPU_LOCAL_READ)
set(DEFINE_dxil PR_GPU_D3D12)
set(DEFINE_wgsl PR_GPU_WEBGPU)
set(DEFINE_dxbc PR_GPU_D3D11)

# pr/gpu_backend.h's PrGpuShaderStage, by the name that Slang's reflection gives the stage, which slangc's -stage option
# also takes.
set(STAGE_vertex 0)
set(STAGE_fragment 1)
set(STAGE_compute 2)

include(${CMAKE_CURRENT_LIST_DIR}/shader_reflect.cmake)

string(REPLACE "|" ";" TARGETS "${TARGETS}")
string(REPLACE "|" ";" INCLUDES "${INCLUDES}")
string(REPLACE "|" ";" DEFINES "${DEFINES}")
if (NOT EXISTS "${SLANGC}")
    message(FATAL_ERROR "shader_library: no slangc at ${SLANGC}")
endif()

# Runs slangc on the source for `target`, writing `output`, its reflection and its dependencies. An empty `output`
# writes no code, for a target that compiles each entry point on its own. Sets REFLECTED to the reflection, and appends
# the files that the source read to INPUTS.
function(slang target directory output name)
    set(reflection "${directory}/${name}.json")
    set(depfile "${directory}/${name}.d")
    set(command "${SLANGC}" "${SOURCE}")
    foreach (define IN LISTS DEFINE_${target} DEFINES)
        list(APPEND command -D ${define}=1)
    endforeach()
    list(APPEND command -warnings-as-errors all -O2 -matrix-layout-row-major -reflection-json "${reflection}"
        -depfile "${depfile}" ${ARGN})
    if (PRECISE)
        list(APPEND command -fp-mode precise)
    endif()
    if (output)
        list(APPEND command -o "${output}")
    endif()
    foreach (include IN LISTS INCLUDES)
        list(APPEND command -I "${include}")
    endforeach()
    run(${command})
    file(READ "${reflection}" reflected)
    set(REFLECTED "${reflected}" PARENT_SCOPE)
    read_depfile("${depfile}")
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Sets RECORDS to (name, stage, group size) for each entry point of a reflection, each "<name>|<stage>|<x>|<y>|<z>".
function(entry_records reflected)
    set(records "")
    string(JSON count ERROR_VARIABLE missing LENGTH "${reflected}" entryPoints)
    if (missing)
        set(count 0)
    endif()
    if (count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach (index RANGE ${last})
            string(JSON name GET "${reflected}" entryPoints ${index} name)
            string(JSON stage GET "${reflected}" entryPoints ${index} stage)
            if (NOT DEFINED STAGE_${stage})
                message(FATAL_ERROR "${name}: entry point ${name} has stage ${stage}, which lib/gpu does not run")
            endif()
            set(group 0|0|0)
            string(JSON size ERROR_VARIABLE none GET "${reflected}" entryPoints ${index} threadGroupSize)
            if (NOT none)
                string(JSON x GET "${size}" 0)
                string(JSON y GET "${size}" 1)
                string(JSON z GET "${size}" 2)
                set(group ${x}|${y}|${z})
            endif()
            list(APPEND records "${name}|${STAGE_${stage}}|${group}")
        endforeach()
    endif()
    set(RECORDS ${records} PARENT_SCOPE)
endfunction()

# pr/gpu.h's PrGpuSlotKind.
set(SLOT_buffer 0)
set(SLOT_rw_buffer 1)
set(SLOT_texture 2)
set(SLOT_rw_texture 3)

# Sets SLOTS to (name, kind, number) for each slot that a reflection of `target` declares, each "<name>|<kind>|<slot>".
# Each target numbers the slots in registers of its own (pr/gpu.slang), from which this
# recovers the slots' numbers. A texture's sampler shares its texture's slot and is not listed.
function(slot_records target reflected)
    set(records "")
    string(JSON count ERROR_VARIABLE missing LENGTH "${reflected}" parameters)
    if (missing)
        set(count 0)
    endif()
    if (count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach (index RANGE ${last})
            string(JSON parameter GET "${reflected}" parameters ${index})
            string(JSON name GET "${parameter}" name)
            string(JSON binding ERROR_VARIABLE single GET "${parameter}" bindings 0)
            if (single)
                string(JSON binding ERROR_VARIABLE unbound GET "${parameter}" binding)
                if (unbound)
                    continue()
                endif()
            endif()
            string(JSON kind GET "${binding}" kind)
            string(JSON space ERROR_VARIABLE none GET "${binding}" space)
            if (none)
                set(space 0)
            endif()
            string(JSON at ERROR_VARIABLE none GET "${binding}" index)
            if (none OR kind STREQUAL "samplerState")
                continue()
            endif()
            set(slot "")
            if (target STREQUAL "metal")
                # An RwTexture slot names its index in an attribute, which Slang's own numbering does not follow.
                string(JSON declared ERROR_VARIABLE plain GET "${parameter}" userAttribs 0 arguments 0)
                if (NOT plain)
                    math(EXPR slot "${declared} - 16")
                    set(slot_kind ${SLOT_rw_texture})
                elseif (kind STREQUAL "constantBuffer" AND space EQUAL 1 AND at GREATER_EQUAL 4 AND at LESS 12)
                    math(EXPR slot "${at} - 4")
                    set(slot_kind ${SLOT_buffer})
                elseif (kind STREQUAL "constantBuffer" AND space EQUAL 1 AND at GREATER_EQUAL 12)
                    math(EXPR slot "${at} - 12")
                    set(slot_kind ${SLOT_rw_buffer})
                elseif (kind STREQUAL "shaderResource" AND space EQUAL 2)
                    set(slot ${at})
                    set(slot_kind ${SLOT_texture})
                endif()
            elseif (target MATCHES "^(spirv|spirv_local_read|wgsl)$")
                # The Vulkan bindings of set 1, which WebGPU's group 1 shares.
                if (kind STREQUAL "descriptorTableSlot" AND space EQUAL 1 AND at GREATER_EQUAL 2)
                    if (at LESS 6)
                        math(EXPR slot "${at} - 2")
                        set(slot_kind ${SLOT_buffer})
                    elseif (at LESS 10)
                        math(EXPR slot "${at} - 6")
                        set(slot_kind ${SLOT_rw_buffer})
                    elseif (at LESS 26)
                        math(EXPR odd "(${at} - 10) % 2")
                        if (odd EQUAL 0)
                            math(EXPR slot "(${at} - 10) / 2")
                            set(slot_kind ${SLOT_texture})
                        endif()
                    else()
                        math(EXPR slot "${at} - 26")
                        set(slot_kind ${SLOT_rw_texture})
                    endif()
                endif()
            elseif (target STREQUAL "dxil")
                if (kind STREQUAL "shaderResource" AND space GREATER_EQUAL 1)
                    set(slot ${at})
                    set(slot_kind ${SLOT_buffer})
                    if (space EQUAL 2)
                        set(slot_kind ${SLOT_texture})
                    endif()
                elseif (kind STREQUAL "unorderedAccess" AND space GREATER_EQUAL 1)
                    set(slot ${at})
                    set(slot_kind ${SLOT_rw_buffer})
                    if (space EQUAL 2)
                        set(slot_kind ${SLOT_rw_texture})
                    endif()
                endif()
            elseif (target STREQUAL "dxbc")
                # Direct3D 11's one space of each kind, which the slots split (pr/gpu.slang).
                if (kind STREQUAL "shaderResource" AND at LESS 4)
                    set(slot ${at})
                    set(slot_kind ${SLOT_buffer})
                elseif (kind STREQUAL "shaderResource")
                    math(EXPR slot "${at} - 4")
                    set(slot_kind ${SLOT_texture})
                elseif (kind STREQUAL "unorderedAccess" AND at LESS 4)
                    set(slot ${at})
                    set(slot_kind ${SLOT_rw_texture})
                elseif (kind STREQUAL "unorderedAccess")
                    math(EXPR slot "${at} - 4")
                    set(slot_kind ${SLOT_rw_buffer})
                endif()
            endif()
            if (NOT slot STREQUAL "")
                list(APPEND records "${name}|${slot_kind}|${slot}")
            endif()
        endforeach()
    endif()
    list(SORT records)
    set(SLOTS ${records} PARENT_SCOPE)
endfunction()

# Compiles the Metal target: one metallib that holds every entry point.
function(compile_metal directory)
    set(source "${directory}/library.metal")
    slang(metal "${directory}" "${source}" metal -target metal)
    # Slang declares every buffer writable. The heaps and the Buffer slots, at buffer indices 4 to 11 (pr/gpu.slang),
    # are only read, and a vertex function that writes nothing may not take writable buffers without a warning.
    file(READ "${source}" text)
    string(REGEX REPLACE "uint32_t device\\* (prGpu(Resource|Sampler)Heap_[0-9]+)" "uint32_t const device* \\1"
           text "${text}")
    # Slang copies each parameter into a field of a context, named alike but for its last number, so the field of each
    # Buffer slot is const too.
    string(REGEX MATCHALL "[A-Za-z_0-9]+ device\\* [A-Za-z_0-9]+ \\[\\[buffer\\(([4-9]|1[01])\\)\\]\\]" read_only
           "${text}")
    set(read_only_names "")
    foreach (parameter IN LISTS read_only)
        string(REGEX REPLACE ".* device\\* ([A-Za-z_0-9]+)_[0-9]+ .*" "\\1" name "${parameter}")
        list(APPEND read_only_names "${name}")
    endforeach()
    list(REMOVE_DUPLICATES read_only_names)
    foreach (name IN LISTS read_only_names)
        string(REGEX REPLACE "([A-Za-z_0-9]+) device\\* (${name}_[0-9]+[ ;])" "\\1 const device* \\2" text
               "${text}")
    endforeach()
    # Slang numbers read-write textures in the order of their declarations, whatever their registers say. An RwTexture
    # slot names its index in a PrGpuMetalTexture attribute (pr/gpu.slang), which moves it from the index that Slang
    # gave it, as the reflection's shader resource.
    string(JSON count ERROR_VARIABLE missing LENGTH "${REFLECTED}" parameters)
    if (NOT missing AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach (index RANGE ${last})
            string(JSON attribute ERROR_VARIABLE none GET "${REFLECTED}" parameters ${index} userAttribs 0)
            if (none)
                continue()
            endif()
            string(JSON attribute_name GET "${attribute}" name)
            if (NOT attribute_name STREQUAL "PrGpuMetalTexture")
                continue()
            endif()
            string(JSON declared GET "${attribute}" arguments 0)
            string(JSON name GET "${REFLECTED}" parameters ${index} name)
            string(JSON given GET "${REFLECTED}" parameters ${index} bindings 0 index)
            string(REGEX REPLACE "(${name}_[0-9]+) \\[\\[texture\\(${given}\\)\\]\\]" "\\1 [[texture(${declared})]]"
                   text "${text}")
        endforeach()
    endif()
    file(WRITE "${source}" "${text}")
    if (NOT METAL_SDK)
        set(METAL_SDK macosx)
    endif()
    set(minimum_macosx -mmacosx-version-min=26.0)
    set(minimum_iphoneos -mios-version-min=26.0)
    set(minimum_iphonesimulator -mios-simulator-version-min=26.0)
    set(minimum_appletvos -mtvos-version-min=26.0)
    set(minimum_appletvsimulator -mtvos-simulator-version-min=26.0)
    # The compiler takes visionOS's minimum in its target alone.
    set(minimum_xros -target air64-apple-xros26.0)
    set(minimum_xrsimulator -target air64-apple-xros26.0-simulator)
    set(math "")
    if (PRECISE)
        set(math -fno-fast-math)
    endif()
    run(xcrun -sdk ${METAL_SDK} metal -std=metal4.0 ${math} ${minimum_${METAL_SDK}} -c "${source}"
        -o "${directory}/library.air")
    run(xcrun -sdk ${METAL_SDK} metallib "${directory}/library.air" -o "${directory}/library.metallib")
    entry_records("${REFLECTED}")
    slot_records(metal "${REFLECTED}")
    set(RECORDS ${RECORDS} PARENT_SCOPE)
    set(SLOTS ${SLOTS} PARENT_SCOPE)
    set(CODES "${directory}/library.metallib" PARENT_SCOPE)
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Compiles a Vulkan target: one SPIR-V module that holds every entry point. It is Vulkan 1.3's SPIR-V, with fine
# derivatives, which every device that lib/gpu runs on has. Handles index the bindless set at set 2 (pr/gpu.slang),
# whatever sets the source declares.
function(compile_spirv target directory)
    slang(${target} "${directory}" "${directory}/library.spv" spirv -target spirv
          -profile spirv_1_6+spvDerivativeControl -fvk-use-entrypoint-name -bindless-space-index 2)
    entry_records("${REFLECTED}")
    slot_records(${target} "${REFLECTED}")
    set(RECORDS ${RECORDS} PARENT_SCOPE)
    set(SLOTS ${SLOTS} PARENT_SCOPE)
    set(CODES "${directory}/library.spv" PARENT_SCOPE)
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Appends to PROBLEMS each field of a reflected structure, and each array, whose offset or stride in a constant buffer
# differs from C's.
function(root_layout_problems type path)
    set(problems ${PROBLEMS})
    string(JSON kind GET "${type}" kind)
    if (kind STREQUAL "array")
        string(JSON element GET "${type}" elementType)
        c_layout("${element}")
        set(stride ${SIZE})
        string(JSON reflected ERROR_VARIABLE none GET "${type}" uniformStride)
        if (NOT none)
            set(stride ${reflected})
        endif()
        if (NOT stride EQUAL SIZE)
            list(APPEND problems "${path} is an array whose elements lie ${stride} bytes apart in a constant buffer, \
and ${SIZE} in C. Make it an array of 4-vectors, or of structures whose size is a multiple of 16 bytes")
        endif()
        set(PROBLEMS ${problems})
        root_layout_problems("${element}" "${path}[]")
        set(PROBLEMS ${PROBLEMS} PARENT_SCOPE)
        return()
    endif()
    if (NOT kind STREQUAL "struct")
        return()
    endif()
    set(at 0)
    string(JSON count LENGTH "${type}" fields)
    if (count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach (index RANGE ${last})
            string(JSON field GET "${type}" fields ${index})
            string(JSON field_type GET "${field}" type)
            string(JSON name GET "${field}" name)
            c_layout("${field_type}")
            set(size ${SIZE})
            math(EXPR at "(${at} + ${ALIGNMENT} - 1) / ${ALIGNMENT} * ${ALIGNMENT}")
            set(reflected ${at})
            string(JSON offset ERROR_VARIABLE none GET "${field}" binding offset)
            if (NOT none)
                set(reflected ${offset})
            endif()
            if (NOT reflected EQUAL at)
                list(APPEND problems
                     "${path}.${name} lies at byte ${reflected} in a constant buffer, and at byte ${at} in C")
                set(PROBLEMS ${problems} PARENT_SCOPE)
                return()
            endif()
            set(PROBLEMS ${problems})
            root_layout_problems("${field_type}" "${path}.${name}")
            set(problems ${PROBLEMS})
            math(EXPR at "${at} + ${size}")
        endforeach()
    endif()
    set(PROBLEMS ${problems} PARENT_SCOPE)
endfunction()

# Fails if the root data that the source declares lays out differently in Direct3D 12's constant buffers than in C,
# which pr/gpu.slang requires them to agree on.
function(check_root_layout reflected)
    set(PROBLEMS "")
    string(JSON count ERROR_VARIABLE missing LENGTH "${reflected}" parameters)
    if (missing OR count EQUAL 0)
        return()
    endif()
    math(EXPR last "${count} - 1")
    foreach (index RANGE ${last})
        string(JSON parameter GET "${reflected}" parameters ${index})
        string(JSON binding_kind ERROR_VARIABLE none GET "${parameter}" binding kind)
        string(JSON type_kind ERROR_VARIABLE none2 GET "${parameter}" type kind)
        if (NOT none AND NOT none2 AND binding_kind STREQUAL "constantBuffer" AND type_kind STREQUAL "constantBuffer")
            string(JSON element GET "${parameter}" type elementType)
            string(JSON name GET "${parameter}" name)
            root_layout_problems("${element}" "${name}")
        endif()
    endforeach()
    if (PROBLEMS)
        list(TRANSFORM PROBLEMS PREPEND "${SOURCE}: ")
        list(JOIN PROBLEMS "\n" text)
        message(FATAL_ERROR "${text}")
    endif()
endfunction()

# Compiles the Direct3D 12 target: the DXIL of each entry point, compiled on its own. The whole module is reflected as
# HLSL without generating its code, which slangc writes only for entry points named with their outputs.
function(compile_dxil directory)
    slang(dxil "${directory}" "" dxil -target hlsl -no-codegen)
    check_root_layout("${REFLECTED}")
    entry_records("${REFLECTED}")
    slot_records(dxil "${REFLECTED}")
    set(SLOTS ${SLOTS} PARENT_SCOPE)
    set(codes "")
    foreach (record IN LISTS RECORDS)
        string(REPLACE "|" ";" fields "${record}")
        list(GET fields 0 name)
        list(GET fields 1 stage)
        foreach (stage_name vertex fragment compute)
            if (STAGE_${stage_name} EQUAL stage)
                set(option ${stage_name})
            endif()
        endforeach()
        slang(dxil "${directory}" "${directory}/${name}.dxil" "${name}" -target dxil -profile sm_6_6 -entry "${name}"
              -stage ${option})
        list(APPEND codes "${directory}/${name}.dxil")
    endforeach()
    set(RECORDS ${RECORDS} PARENT_SCOPE)
    set(CODES ${codes} PARENT_SCOPE)
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Compiles the Direct3D 11 target: the DXBC of each entry point, compiled on its own for shader model 5.0. Shader model
# 5.0 has no descriptor heaps, so an entry point that reaches a resource by handle, which its HLSL reads from a heap,
# has no code, and the device refuses a pipeline of it.
function(compile_dxbc directory)
    slang(dxbc "${directory}" "" dxbc -target hlsl -no-codegen)
    check_root_layout("${REFLECTED}")
    entry_records("${REFLECTED}")
    slot_records(dxbc "${REFLECTED}")
    set(SLOTS ${SLOTS} PARENT_SCOPE)
    set(codes "")
    foreach (record IN LISTS RECORDS)
        string(REPLACE "|" ";" fields "${record}")
        list(GET fields 0 name)
        list(GET fields 1 stage)
        foreach (stage_name vertex fragment compute)
            if (STAGE_${stage_name} EQUAL stage)
                set(option ${stage_name})
            endif()
        endforeach()
        slang(dxbc "${directory}" "${directory}/${name}.hlsl" "${name}" -target hlsl -entry "${name}" -stage ${option})
        file(READ "${directory}/${name}.hlsl" hlsl)
        if (hlsl MATCHES "DescriptorHeap")
            file(WRITE "${directory}/${name}.dxbc" "")
        else()
            slang(dxbc "${directory}" "${directory}/${name}.dxbc" "${name}" -target dxbc -profile sm_5_0 -entry "${name}"
                  -stage ${option})
        endif()
        list(APPEND codes "${directory}/${name}.dxbc")
    endforeach()
    set(RECORDS ${RECORDS} PARENT_SCOPE)
    set(CODES ${codes} PARENT_SCOPE)
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Compiles the WebGPU target: WGSL for each entry point on its own, so that an entry point that reaches resources by
# handle, which WebGPU cannot run, leaves the module of every other entry point valid. Handles index binding arrays at
# group 2, which the device refuses. Each module turns off WGSL's check that derivatives are taken in uniform control
# flow, which the other targets do not make, so that derivatives follow their rules (pr/gpu.slang's prGpuDdxFine).
function(compile_wgsl directory)
    slang(wgsl "${directory}" "" wgsl -target wgsl -no-codegen)
    entry_records("${REFLECTED}")
    slot_records(wgsl "${REFLECTED}")
    set(SLOTS ${SLOTS} PARENT_SCOPE)
    set(codes "")
    foreach (record IN LISTS RECORDS)
        string(REPLACE "|" ";" fields "${record}")
        list(GET fields 0 name)
        list(GET fields 1 stage)
        foreach (stage_name vertex fragment compute)
            if (STAGE_${stage_name} EQUAL stage)
                set(option ${stage_name})
            endif()
        endforeach()
        slang(wgsl "${directory}" "${directory}/${name}.wgsl" "${name}" -target wgsl -entry "${name}" -stage ${option}
              -bindless-space-index 2)
        file(READ "${directory}/${name}.wgsl" code)
        # Slang copies a varying's interpolation onto the field of a structure that a function takes, which has no
        # location, and WGSL allows the attribute only beside one.
        string(REGEX REPLACE "@interpolate\\([a-z, ]*\\) +([A-Za-z_])" "\\1" code "${code}")
        file(WRITE "${directory}/${name}.wgsl" "diagnostic(off, derivative_uniformity);\n${code}")
        list(APPEND codes "${directory}/${name}.wgsl")
    endforeach()
    set(RECORDS ${RECORDS} PARENT_SCOPE)
    set(CODES ${codes} PARENT_SCOPE)
    set(INPUTS ${INPUTS} PARENT_SCOPE)
endfunction()

# Sets `out` to the hex of a little-endian 32-bit word.
function(word out value)
    math(EXPR hex "${value}" OUTPUT_FORMAT HEXADECIMAL)
    string(TOLOWER "${hex}" hex)
    string(SUBSTRING "${hex}" 2 -1 hex)
    string(LENGTH "${hex}" length)
    math(EXPR padding "8 - ${length}")
    string(REPEAT "0" ${padding} zeros)
    set(hex "${zeros}${hex}")
    string(SUBSTRING "${hex}" 6 2 b0)
    string(SUBSTRING "${hex}" 4 2 b1)
    string(SUBSTRING "${hex}" 2 2 b2)
    string(SUBSTRING "${hex}" 0 2 b3)
    set(${out} "${b0}${b1}${b2}${b3}" PARENT_SCOPE)
endfunction()

# Appends zero bytes to the hex in `variable` until its length is a multiple of 16 bytes.
function(align variable)
    string(LENGTH "${${variable}}" length)
    math(EXPR padding "(16 - ${length} / 2 % 16) % 16")
    string(REPEAT "00" ${padding} zeros)
    set(${variable} "${${variable}}${zeros}" PARENT_SCOPE)
endfunction()

# If both Vulkan targets are named, the local-read module compiles first, because it shows whether the source reads the
# target.
if ("spirv" IN_LIST TARGETS AND "spirv_local_read" IN_LIST TARGETS)
    list(REMOVE_ITEM TARGETS spirv)
    list(APPEND TARGETS spirv)
endif()

set(INPUTS "${SOURCE}")
set(ENTRIES "")
set(ENTRIES_SET FALSE)
foreach (target IN LISTS TARGETS)
    set(scratch "${SCRATCH}/${target}")
    file(REMOVE_RECURSE "${scratch}")
    file(MAKE_DIRECTORY "${scratch}")
    if (target STREQUAL "metal")
        compile_metal("${scratch}")
    elseif (target STREQUAL "spirv_local_read")
        compile_spirv(spirv_local_read "${scratch}")
        # A module that reads the target declares OpCapability InputAttachment, whose little-endian words follow the
        # module's header.
        file(READ "${scratch}/library.spv" module HEX)
        string(FIND "${module}" "1100020028000000" READS_TARGET)
    elseif (target STREQUAL "spirv" AND DEFINED READS_TARGET AND READS_TARGET EQUAL -1)
        set(CODES ${CODES_spirv_local_read})
        set(SLOTS ${SLOTS_spirv_local_read})
    elseif (target STREQUAL "spirv")
        compile_spirv(spirv "${scratch}")
    elseif (target STREQUAL "dxil")
        compile_dxil("${scratch}")
    elseif (target STREQUAL "wgsl")
        compile_wgsl("${scratch}")
    elseif (target STREQUAL "dxbc")
        compile_dxbc("${scratch}")
    else()
        message(FATAL_ERROR "shader_library: no target named ${target}")
    endif()
    if (NOT ENTRIES_SET)
        set(ENTRIES ${RECORDS})
        set(SLOT_RECORDS ${SLOTS})
        set(ENTRIES_SET TRUE)
    elseif (NOT "${RECORDS}" STREQUAL "${ENTRIES}")
        message(FATAL_ERROR "${SOURCE}: the entry points differ between targets")
    elseif (NOT "${SLOTS}" STREQUAL "${SLOT_RECORDS}")
        message(FATAL_ERROR "${SOURCE}: the slots differ between targets: ${SLOTS} against ${SLOT_RECORDS}")
    endif()
    set(CODES_${target} ${CODES})
    set(SLOTS_${target} ${SLOTS})
endforeach()
list(LENGTH ENTRIES entry_count)
list(LENGTH TARGETS target_count)
list(LENGTH SLOT_RECORDS slot_count)
# A build with no backend compiles for no target, and its library is empty. The entry points are what the compiled code
# reflects, so a library of no target has none.
if (entry_count EQUAL 0 AND target_count GREATER 0)
    message(FATAL_ERROR "${SOURCE}: no entry points")
endif()

# The library's bytes, as hex: the tables, the names, then the blobs, each placed once however many entry points share
# it.
math(EXPR tables_size "20 + 24 * ${entry_count} + 16 * ${slot_count} + (4 + 8 * ${entry_count}) * ${target_count}")
set(names "")
set(entry_hex "")
foreach (record IN LISTS ENTRIES)
    string(REPLACE "|" ";" fields "${record}")
    list(GET fields 0 name)
    string(HEX "${name}" name_hex)
    string(LENGTH "${names}" names_length)
    string(LENGTH "${name_hex}" name_length)
    math(EXPR offset "${tables_size} + ${names_length} / 2")
    math(EXPR name_length "${name_length} / 2")
    foreach (value ${offset} ${name_length})
        word(hex ${value})
        string(APPEND entry_hex "${hex}")
    endforeach()
    list(SUBLIST fields 1 4 numbers)
    foreach (value IN LISTS numbers)
        word(hex ${value})
        string(APPEND entry_hex "${hex}")
    endforeach()
    string(APPEND names "${name_hex}")
endforeach()
set(slot_hex "")
foreach (record IN LISTS SLOT_RECORDS)
    string(REPLACE "|" ";" fields "${record}")
    list(GET fields 0 name)
    list(GET fields 1 kind)
    list(GET fields 2 slot)
    string(HEX "${name}" name_hex)
    string(LENGTH "${names}" names_length)
    string(LENGTH "${name_hex}" name_length)
    math(EXPR offset "${tables_size} + ${names_length} / 2")
    math(EXPR name_length "${name_length} / 2")
    foreach (value ${offset} ${name_length} ${kind} ${slot})
        word(hex ${value})
        string(APPEND slot_hex "${hex}")
    endforeach()
    string(APPEND names "${name_hex}")
endforeach()
set(blobs "${names}")
align(blobs)
set(target_hex "")
foreach (target IN LISTS TARGETS)
    word(hex ${TARGET_${target}})
    string(APPEND target_hex "${hex}")
    list(LENGTH CODES_${target} code_count)
    foreach (index RANGE 1 ${entry_count})
        # A target with one code gives it to every entry point.
        if (code_count EQUAL 1)
            list(GET CODES_${target} 0 code)
        else()
            math(EXPR at "${index} - 1")
            list(GET CODES_${target} ${at} code)
        endif()
        string(MAKE_C_IDENTIFIER "${code}" key)
        if (NOT DEFINED PLACED_${key})
            string(LENGTH "${blobs}" blobs_length)
            math(EXPR PLACED_${key} "${tables_size} + ${blobs_length} / 2")
            file(READ "${code}" code_hex HEX)
            string(LENGTH "${code_hex}" code_length)
            math(EXPR SIZE_${key} "${code_length} / 2")
            string(APPEND blobs "${code_hex}")
            align(blobs)
        endif()
        word(hex ${PLACED_${key}})
        string(APPEND target_hex "${hex}")
        word(hex ${SIZE_${key}})
        string(APPEND target_hex "${hex}")
    endforeach()
endforeach()
set(library "")
foreach (value ${MAGIC} ${VERSION} ${entry_count} ${target_count} ${slot_count})
    word(hex ${value})
    string(APPEND library "${hex}")
endforeach()
string(APPEND library "${entry_hex}${slot_hex}${target_hex}${blobs}")

# The header: 24 bytes to a line.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${library}")
string(REPEAT "." 120 line)
string(REGEX REPLACE "(${line})" "    \\1\n" bytes "${bytes}")
string(FIND "${bytes}" "\n" end REVERSE)
math(EXPR end "${end} + 1")
string(SUBSTRING "${bytes}" ${end} -1 rest)
if (rest)
    string(SUBSTRING "${bytes}" 0 ${end} bytes)
    string(APPEND bytes "    ${rest}\n")
endif()
cmake_path(RELATIVE_PATH SOURCE BASE_DIRECTORY "${ROOT}" OUTPUT_VARIABLE relative)
file(CONFIGURE OUTPUT "${HEADER}" @ONLY CONTENT "// Generated by cmake/shader_library.cmake from @relative@. Do not edit.

#pragma once

alignas(16) const unsigned char @VARIABLE@[] = {
@bytes@};
")

# The dependency file: the header, and every file that a compile read.
if (DEPFILE)
    write_depfile("${DEPFILE}" "${HEADER}")
endif()
