# Editor settings that match docs/conventions.md and what lint.py checks. .gitattributes keeps the line endings in the
# repository and in every checkout LF, whatever an editor is set to.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{html,htm,xhtml,svg,xml,md}]
indent_size = 2

# A diff's context lines begin with a space, and a blank line of context is that space alone.
[*.patch]
trim_trailing_whitespace = false
max_line_length = off

[LICENSE-*]
max_line_length = off
