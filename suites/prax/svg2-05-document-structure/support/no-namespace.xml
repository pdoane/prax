<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="xml.css" type="text/css"?>
<!-- An svg element with no namespace declaration, in XML: it is not in the SVG namespace, so it draws no rect. -->
<svg width="160" height="60">
  <rect x="20" y="10" width="120" height="40" fill="#4f81bd" />
</svg>
