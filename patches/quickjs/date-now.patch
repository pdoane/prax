-static int64_t date_now(void) {
+/* the UTC time in ms since 1970: the runtime's function's, or else the OS's */
+static int64_t date_now(JSContext *ctx) {
+    if (ctx->rt->date_now_func)
+        return ctx->rt->date_now_func(ctx);
     return js__gettimeofday_us() / 1000;
 }
 
+void JS_SetDateNowFunc(JSRuntime *rt, JSDateNowFunc *func)
+{
+    rt->date_now_func = func;
+}
+
+int64_t JS_DateNow(JSContext *ctx)
+{
+    return date_now(ctx);
+}
