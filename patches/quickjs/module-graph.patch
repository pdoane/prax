diff --git a/quickjs.c b/quickjs.c
index 8cbc85e..9adc686 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -31332,6 +31332,27 @@ JSValue JS_GetModuleNamespace(JSContext *ctx, JSModuleDef *m)
     return js_dup(m->module_ns);
 }
 
+int JS_GetModuleRequestCount(JSModuleDef *m)
+{
+    return m->req_module_entries_count;
+}
+
+JSAtom JS_GetModuleRequest(JSContext *ctx, JSModuleDef *m, int index)
+{
+    return JS_DupAtom(ctx, m->req_module_entries[index].module_name);
+}
+
+JSValue JS_GetModuleRequestAttributes(JSContext *ctx, JSModuleDef *m, int index)
+{
+    return js_dup(m->req_module_entries[index].attributes);
+}
+
+void JS_SetModuleAttributes(JSContext *ctx, JSModuleDef *m, JSValue attributes)
+{
+    JS_FreeValue(ctx, m->attributes);
+    m->attributes = attributes;
+}
+
 #ifdef ENABLE_DUMPS // JS_DUMP_MODULE_RESOLVE
 #define module_trace(ctx, ...) \
    do { \
@@ -38306,10 +38327,9 @@ static JSValue __JS_EvalInternal(JSContext *ctx, JSValueConst this_obj,
     fun_obj = js_create_function(ctx, fd);
     if (JS_IsException(fun_obj))
         goto fail1;
-    /* Could add a flag to avoid resolution if necessary */
     if (m) {
         m->func_obj = fun_obj;
-        if (js_resolve_module(ctx, m) < 0)
+        if (!(flags & JS_EVAL_FLAG_NO_RESOLVE) && js_resolve_module(ctx, m) < 0)
             goto fail1;
         fun_obj = JS_NewModuleValue(ctx, m);
     }
diff --git a/quickjs.h b/quickjs.h
index 1324066..68e6311 100644
--- a/quickjs.h
+++ b/quickjs.h
@@ -463,6 +463,9 @@ static inline bool JS_VALUE_IS_NAN(JSValue v)
 /* allow top-level await in normal script. JS_Eval() returns a
    promise. Only allowed with JS_EVAL_TYPE_GLOBAL */
 #define JS_EVAL_FLAG_ASYNC (1 << 7)
+/* with JS_EVAL_FLAG_COMPILE_ONLY, compile a module without loading
+   the modules it imports. JS_ResolveModule() loads them. */
+#define JS_EVAL_FLAG_NO_RESOLVE (1 << 8)
 
 typedef JSValue JSCFunction(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv);
 typedef JSValue JSCFunctionMagic(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv, int magic);
@@ -1278,6 +1281,16 @@ JS_EXTERN int JS_FinishDynamicImport(JSContext *ctx, JSValue token,
 JS_EXTERN JSValue JS_GetImportMeta(JSContext *ctx, JSModuleDef *m);
 JS_EXTERN JSAtom JS_GetModuleName(JSContext *ctx, JSModuleDef *m);
 JS_EXTERN JSValue JS_GetModuleNamespace(JSContext *ctx, JSModuleDef *m);
+/* return the number of modules that 'm' imports, and the specifier of
+   each as its source writes it, which the caller frees */
+JS_EXTERN int JS_GetModuleRequestCount(JSModuleDef *m);
+JS_EXTERN JSAtom JS_GetModuleRequest(JSContext *ctx, JSModuleDef *m, int index);
+/* return the import attributes of request 'index' of 'm', or undefined if
+   it has none */
+JS_EXTERN JSValue JS_GetModuleRequestAttributes(JSContext *ctx, JSModuleDef *m, int index);
+/* set the import attributes that a request must have to resolve to 'm',
+   taking 'attributes' */
+JS_EXTERN void JS_SetModuleAttributes(JSContext *ctx, JSModuleDef *m, JSValue attributes);
 
 /* associate a JSValue to a C module */
 JS_EXTERN int JS_SetModulePrivateValue(JSContext *ctx, JSModuleDef *m, JSValue val);
