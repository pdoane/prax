     int64_t module_async_evaluation_next_timestamp;
 
@@ -26356,6 +26357,11 @@
     rt->module_loader_opaque = opaque;
 }
 
+void JS_SetModuleImportFunc(JSRuntime *rt, JSModuleImportFunc *module_import)
