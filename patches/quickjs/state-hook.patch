diff --git a/quickjs.h b/quickjs.h
index 087b557..6fb8140 100644
--- a/quickjs.h
+++ b/quickjs.h
@@ -572,6 +572,12 @@ typedef JSValue JSClassCall(JSContext *ctx, JSValueConst func_obj,
                             JSValueConst this_val, int argc,
                             JSValueConst *argv, int flags);
 
+/* Called as an object of the class may first hold what a new object of the class would not: an
+   own property is added, its prototype changes, it is made non-extensible, or it becomes the
+   target of a weak reference. It may be called again for the same object. It runs no JS code and
+   frees no value. */
+typedef void JSClassStateHook(JSRuntime *rt, JSValueConst obj);
+
 typedef struct JSClassDef {
     const char *class_name; /* pure ASCII only! */
     JSClassFinalizer *finalizer;
@@ -585,6 +591,7 @@ typedef struct JSClassDef {
     /* XXX: suppress this indirection ? It is here only to save memory
        because only a few classes need these methods */
     JSClassExoticMethods *exotic;
+    JSClassStateHook *state;
 } JSClassDef;
 
