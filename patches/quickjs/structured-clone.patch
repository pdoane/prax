+/* The buffer of a DataView or a typed array, with its offset and its length in bytes. A length that tracks the buffer
+   sets `track`. */
+JSValue JS_GetViewBuffer(JSContext *ctx, JSValueConst obj, size_t *offset, size_t *length, bool *track)
+{
+    JSObject *p = JS_VALUE_GET_OBJ(obj);
+    JSTypedArray *ta = p->u.typed_array;
+
+    *offset = ta->offset;
+    *length = ta->length;
+    *track = ta->track_rab;
+    return js_dup(JS_MKPTR(JS_TAG_OBJECT, ta->buffer));
+}
+
+/* A new DataView of the realm, which no script can intercept. */
+JSValue JS_NewDataView(JSContext *ctx, JSValueConst buffer, size_t offset, size_t length, bool track)
+{
+    JSValueConst args[3];
+
+    args[0] = buffer;
+    args[1] = js_uint32((uint32_t)offset);
+    args[2] = js_uint32((uint32_t)length);
+    return js_dataview_constructor(ctx, JS_UNDEFINED, track ? 2 : 3, args);
+}
